<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsOhMyBotPlugin>true</IsOhMyBotPlugin>
        <PluginName>PlaywrightProvider</PluginName>
        <AssemblyName>OhMyBot.Plugins.PlaywrightProvider</AssemblyName>
        <RootNamespace>OhMyBot.Plugins.PlaywrightProvider</RootNamespace>
        <PlaywrightPlatform Condition="'$(Configuration)' == 'Release'">linux-arm64</PlaywrightPlatform>
        <PlaywrightPlatform Condition="'$(Configuration)' != 'Release'">linux-arm64;osx-arm64</PlaywrightPlatform>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="6.0.0" GeneratePathProperty="true" />
        <PackageReference Include="Microsoft.Playwright" Version="1.62.0" GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="PackagePlaywrightProviderRuntime"
            AfterTargets="BuildPluginPackage"
            BeforeTargets="DeployPluginToLocalHost">
        <ItemGroup>
            <_PlaywrightDarwinRuntime Include="$(TargetDir).playwright/node/darwin-arm64/**/*"
                                      Condition="'$(Configuration)' != 'Release'" />
            <_PlaywrightLinuxRuntime Include="$(TargetDir).playwright/node/linux-arm64/**/*" />
            <_PlaywrightDriverPackage Include="$(TargetDir).playwright/package/**/*"
                                      Exclude="$(TargetDir).playwright/package/.local-browsers/**/*" />
        </ItemGroup>
        <Copy SourceFiles="$(PkgMicrosoft_Playwright)/lib/netstandard2.0/Microsoft.Playwright.dll"
              DestinationFolder="$(PluginPackageDir)" />
        <Copy SourceFiles="$(PkgMicrosoft_Bcl_AsyncInterfaces)/lib/netstandard2.1/Microsoft.Bcl.AsyncInterfaces.dll"
              DestinationFolder="$(PluginPackageDir)" />
        <Copy SourceFiles="$(TargetDir).playwright/node/LICENSE"
              DestinationFiles="$(PluginPackageDir).playwright/node/LICENSE" />
        <Copy SourceFiles="@(_PlaywrightDarwinRuntime)"
              DestinationFiles="@(_PlaywrightDarwinRuntime->'$(PluginPackageDir).playwright/node/darwin-arm64/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(_PlaywrightLinuxRuntime)"
              DestinationFiles="@(_PlaywrightLinuxRuntime->'$(PluginPackageDir).playwright/node/linux-arm64/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(_PlaywrightDriverPackage)"
              DestinationFiles="@(_PlaywrightDriverPackage->'$(PluginPackageDir).playwright/package/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
